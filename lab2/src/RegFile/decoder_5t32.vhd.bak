library IEEE;
use IEEE.std_logic_1164.all;

entity decoder_5t32 is
    port(
            i_D : in std_logic_vector(4 downto 0);
            o_Q : out std_logic_vector(31 downto 0)
    );
end decoder_5t32;

architecture dataflow of decoder_5t32 is
    begin
        with i_D select
            o_Q <=  x"00000001" when x"00000",
                    x"00000002" when x"00001",
                    x"00000004" when x"00010",
                    x"00000008" when x"00011",
                    x"00000010" when x"00100",
                    x"00000020" when x"00101",
                    x"00000040" when x"00110",
                    x"00000080" when x"00111",
                    x"00000100" when x"01000",
                    x"00000200" when x"01001",
                    x"00000400" when x"01010",
                    x"00000800" when x"01011",
                    x"00001000" when x"01100",
                    x"00002000" when x"01101",
                    x"00004000" when x"01110",
                    x"00008000" when x"01111",
                    x"00010000" when x"10000",
                    x"00020000" when x"10001",
                    x"00040000" when x"10010",
                    x"00080000" when x"10011",
                    x"00100000" when x"10100",
                    x"00200000" when x"10101",
                    x"00400000" when x"10110",
                    x"00800000" when x"10111",
                    x"01000000" when x"11000",
                    x"02000000" when x"11001",
                    x"04000000" when x"11010",
                    x"08000000" when x"11011",
                    x"10000000" when x"11100",
                    x"20000000" when x"11101",
                    x"40000000" when x"11110",
                    x"80000000" when x"11111",
                    x"00000000" when others;

    end dataflow;

