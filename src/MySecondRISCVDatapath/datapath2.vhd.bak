-- datapath2.vhd
-------------------------------------------------------------------------
Library IEEE;
use IEEE.std_logic_1164.all;

entity datapath2 is
    port(i_CLK      : in std_logic;
         i_RST      : in std_logic;
         i_RegWrite : in std_logic;
         i_ALUSrc   : in std_logic;
         i_nAdd_Sub : in std_logic;
         i_MemWrite : in std_logic;
         i_MemToReg : in std_logic;
         i_ImmType  : in std_logic;
         i_imm12      : in std_logic_vector(11 downto 0);
         i_imm20      : in std_logic_vector(19 downto 0);
         i_RS1      : in std_logic_vector(4 downto 0);
         i_RS2      : in std_logic_vector(4 downto 0);
         i_RD       : in std_logic_vector(4 downto 0);
         o_Read1    : out std_logic_vector(31 downto 0);
         o_Read2    : out std_logic_vector(31 downto 0);
         o_ALUResult   : out std_logic_vector(31 downto 0);
         o_MemData : out std_logic_vector(31 downto 0);
         o_MemWriteBack : out std_logic_vector(31 downto 0)
        );
end datapath2;

architecture structural of datapath2 is
    signal s_A, s_B, s_SignImm, s_UpperImm, s_Imm : std_logic_vector(31 downto 0);
    signal s_ALU, s_Mem, s_WB : std_logic_vector(31 downto 0);
    signal s_MemWrite : std_logic;

    begin
    reg_file : entity work.reg_file
        port map
        (
            i_CLK   => i_CLK,
            i_RST   => i_RST,
            i_WE    => i_RegWrite,
            i_RS1   => i_RS1,
            i_RS2   => i_RS2,
            i_RD    => i_RD,
            i_Data  => s_WB,
            o_Read1 => s_A,
            o_Read2 => s_B
        );

    SignExt : entity work.extend_n
        generic map(N => 12)
        port map
        (
            i_D    => i_imm12,
            i_Sign => '1',
            o_Q    => s_SignImm
        );
        s_UpperImm <= i_imm20 & x"000";
        ImmMux : entity work.Mux2to1
        generic map(N => 32)
        port map
        (
            i_A => s_SignImm,
            i_B => s_UpperImm,
            i_Sel => i_ImmType,
            o_Q => s_Imm
        );  
        ALU : entity work.AddSub_mod
        generic map(N => 32)
        port map
        (
            i_A        => s_A,
            i_B        => s_B,
            i_nAdd_Sub => i_nAdd_Sub,
            i_imm      => s_Imm,
            i_ALUSrc   => i_ALUSrc,
            o_S        => s_ALU,        
            o_C        => open
        );
        dmem : entity work.mem
        generic map(DATA_WIDTH => 32, ADDR_WIDTH => 10, BYTE_WIDTH => 4)
        port map(
            clk => i_CLK,
            addr => s_ALU(11 downto 2),
            data => s_B,
            q => s_Mem,
            we => i_MemWrite,
            be => "1111"
        );
        WB_Mux : entity work.Mux2t1_N
        generic map(N => 32)
        port map
        (
            i_S => i_MemToReg,
            i_D0 => s_ALU,
            i_D1 => s_Mem,
            o_O => s_WB
        );
        o_Read1  <= s_A;
        o_Read2  <= s_B;
        o_ALUResult <= s_ALU;
        o_MemData <= s_Mem;
        o_MemWriteBack <= s_WB;
end structural;




